# ============================================================
# MediClick - Variables de Entorno
# COPIAR A .env Y CAMBIAR LOS VALORES
# ============================================================

# ─── PostgreSQL ──────────────────────────────────────────────
DB_USER=mediclick
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
DATABASE_URL=postgresql://mediclick:CAMBIAR_PASSWORD_SEGURO@postgres:5432/mediclick

# ─── Redis (cache local, gratis) ────────────────────────────
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD

# ─── JWT (generar con: openssl rand -hex 32) ────────────────
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_hex_32
JWT_REFRESH_SECRET=CAMBIAR_generar_con_openssl_rand_hex_32

# ─── Cifrado de datos sensibles ─────────────────────────────
ENCRYPTION_KEY=CAMBIAR_generar_con_openssl_rand_hex_16

# ─── SSL/HTTPS (Let's Encrypt - gratis) ─────────────────────
ACME_EMAIL=tu_email@dominio.com

# ─── API Config ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Push Notifications (opcionales - gratis) ───────────────
# APNs para iOS: necesitás una cuenta de Apple Developer ($99/año)
# FCM para Android: gratis con cuenta Google
# NOTA: el chat funciona igual sin push, solo que el usuario
# no recibe notificaciones cuando la app está cerrada
# APN_KEY_ID=
# APN_TEAM_ID=
# APN_KEY_PATH=./certs/apns.p8
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_PATH=./certs/firebase.json
